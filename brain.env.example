# Copy this to `brain.env` on the server and fill in REAL production values, then lock it down:
#   cp brain.env.example brain.env && chmod 600 brain.env
# `brain.env` is gitignored — never commit real secrets.

# --- Auth ------------------------------------------------------------------
# Shared secret every caller must send as: Authorization: Bearer <BRAIN_API_KEY>.
# DocLens MUST use this SAME value for its BRAIN_API_KEY.
# Generate: openssl rand -hex 32
BRAIN_API_KEY=REPLACE_ME

# --- Ollama Cloud (Brain's DEFAULT provider) -------------------------------
# Callers may override the provider per request via BYOK; this is only the default.
OLLAMA_API_KEY=REPLACE_ME
OLLAMA_BASE_URL=https://ollama.com
CHAT_MODEL=gpt-oss:120b

# --- Qdrant (self-hosted in the shared infra stack) ------------------------
# Qdrant runs ONCE in /srv/infra, reached over the `data` network as host "qdrant". No API key: it is
# never published. Each app gets its own collection, derived from the request's app_name
# (e.g. app_name="doclens" -> collection "doclens"). QDRANT_COLLECTION_PREFIX namespaces them all.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=
